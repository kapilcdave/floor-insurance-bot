# Alpaca paper credentials. Never commit real values.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Safety gates: paper + dry-run are the defaults.
ALPACA_PAPER=true
DRY_RUN=true
SHADOW_MODE=false
LIVE_TRADING_CONFIRMED=false
# Separate guard for the unvalidated ATM strategy.
ATM_LIVE_CONFIRMED=false

# Free paper-data defaults. Live mode requires sip + opra.
STOCK_FEED=iex
OPTIONS_FEED=indicative

# Strategy
UNDERLYING=IWM
# Defaults to UNDERLYING for ETFs and to SPY for XSP.
SIGNAL_SYMBOL=IWM
TREND_WINDOW=20
# above = every eligible session; crossover = first session after a fresh cross.
TREND_MODE=crossover
# ATM is the active hypothesis. buffered retains the measured legacy structure.
STRIKE_SELECTION=atm
BUFFER_DOLLARS=15
SPREAD_WIDTH=1
# Close when the executable spread debit reaches this multiple of entry credit.
STOP_DEBIT_MULTIPLE=1.5
# Hard cap across all spreads opened by the bot on one session.
MAX_TOTAL_LOSS_DOLLARS=100
# Legacy buffered-strike setting; unused by the ATM stop.
STOP_BUFFER=3
RISK_FRACTION=0.01
# Optional absolute max-loss budget. For one $1-wide spread, $100 risks nearly
# the full account; leave blank to size only from RISK_FRACTION.
RISK_BUDGET_DOLLARS=
# none holds until the stop or 15:00 ET.
TAKE_PROFIT_FRACTION=none
MIN_CREDIT=0.05
# Shadow mode may exercise penny-credit spreads without weakening live safeguards.
SHADOW_MIN_CREDIT=0.01
MAX_CONTRACTS=1
MAX_DAILY_ENTRIES=1
MAX_DAILY_LOSSES=3

# America/New_York schedule
ENTRY_TIME_ET=09:45
ENTRY_CUTOFF_TIME_ET=14:00
TAKE_PROFIT_CUTOFF_TIME_ET=14:00
HARD_CLOSE_TIME_ET=15:00

# Operations
POLL_SECONDS_IDLE=60
POLL_SECONDS_OPEN=15
REQUEST_TIMEOUT_SECONDS=10
# The free indicative options feed can update less often than OPRA.
MAX_QUOTE_AGE_SECONDS=90
STATE_PATH=state/daily.json
SHADOW_LOG_PATH=state/shadow_events.jsonl
LOG_LEVEL=INFO

# Shadow-only portfolio assumptions; no broker orders are submitted.
SHADOW_EQUITY=10000
SHADOW_FEES_PER_SPREAD=0

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
